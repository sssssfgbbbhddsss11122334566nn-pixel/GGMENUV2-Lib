                elseif cloned:IsA("BasePart") then
                    model = Instance.new("Model")
                    cloned.Parent = model
                    model.PrimaryPart = cloned
                else
                    cloned:Destroy()
                end
            end
        end

        if not model then
            model = Instance.new("Model")
            local part = Instance.new("Part")
            part.Name = "PreviewShape"
            local shape = item.Shape
            if typeof(shape) ~= "EnumItem" or shape.EnumType ~= Enum.PartType then shape = Enum.PartType.Block end
            local size = typeof(item.Size) == "Vector3" and item.Size or Vector3.new(1.7, 1.7, 1.7)
            part.Shape = shape
            part.Size = size
            part.Color = typeof(item.Color) == "Color3" and item.Color or window.Theme.Accent
            local material = item.Material
            if typeof(material) ~= "EnumItem" or material.EnumType ~= Enum.Material then material = Enum.Material.SmoothPlastic end
            part.Material = material
            part.Anchored = true
            part.CanCollide = false
            part.Parent = model
            model.PrimaryPart = part
        end

        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") or descendant:IsA("Tool") then
                descendant:Destroy()
            end
        end
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
                if not item.Model and typeof(item.Color) == "Color3" then descendant.Color = item.Color end
            end
        end
        model.Name = tostring(item.Name or "Preview")
        model.Parent = world
        local baseRotation = CFrame.new()
        pcall(function()
            local pivot = model:GetPivot()
            local boundsCFrame = model:GetBoundingBox()
            local centeredPivot = CFrame.new(-boundsCFrame.Position) * pivot
            model:PivotTo(centeredPivot)
            baseRotation = centeredPivot.Rotation
        end)
        return model, baseRotation
    end

    local function fitModel(model, camera, minimumDistance)
        if not model or not camera then return end
        pcall(function()
            local bounds = model:GetExtentsSize()
            local largestSide = math.max(bounds.X, bounds.Y, bounds.Z)
            local distance = math.max(minimumDistance, largestSide * 1.45)
            camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
        end)
    end

    local initialIndex = math.clamp(math.floor(tonumber(config.DefaultIndex) or 1), 1, #items)
    local currentIndex = initialIndex
    local currentMainModel
    local currentExpandedModel
    local currentMainRotation = CFrame.new()
    local currentExpandedRotation = CFrame.new()
    local function refresh(silent)
        local item = items[currentIndex]
        valueLabel.Text = tostring(item.Name or ("Item " .. currentIndex)) .. "  (" .. currentIndex .. "/" .. #items .. ")"
        modalTitle.Text = string.upper(tostring(item.Name or "PREVIEW 3D"))
        currentMainModel, currentMainRotation = makeModel(mainWorld, item)
        currentExpandedModel, currentExpandedRotation = makeModel(expandedWorld, item)
        fitModel(currentMainModel, mainCamera, tonumber(config.CameraDistance) or 5.4)
        fitModel(currentExpandedModel, expandedCamera, tonumber(config.ExpandedCameraDistance) or 6.4)
        if not silent then invoke(config.OnChanged, item, currentIndex) end
    end
    local control = { Instance = card, Value = items[currentIndex] }
    function control:SetIndex(index, silent)
        local numericIndex = tonumber(index)
        if not numericIndex then return end
        currentIndex = ((math.floor(numericIndex) - 1) % #items) + 1
        control.Value = items[currentIndex]
        refresh(silent)
    end
    function control:Next()
        control:SetIndex(currentIndex + 1)
    end
    function control:Previous()
        control:SetIndex(currentIndex - 1)
    end
    function control:GetValue()
        return control.Value, currentIndex
    end
    function control:OpenExpanded()
        backdrop.Visible = true
    end
    function control:CloseExpanded()
        backdrop.Visible = false
    end
    function control:Select(silent)
        if not silent then invoke(config.OnSelect, control.Value, currentIndex) end
        backdrop.Visible = false
        return control.Value
    end
    function control:Reset(silent)
        control:SetIndex(initialIndex, silent)
    end

    local expandButton = Instance.new("TextButton")
    expandButton.Size = UDim2.new(1, -18, 0, 30)
    expandButton.Position = UDim2.new(0, 9, 1, -37)
    expandButton.BackgroundColor3 = window.Theme.Accent2 or window.Theme.Accent
    expandButton.Text = config.ExpandText or "AMPLIAR E ESCOLHER"
    expandButton.TextColor3 = Color3.fromRGB(5, 18, 18)
    expandButton.TextSize = 9
    expandButton.Font = Enum.Font.GothamBold
    expandButton.Parent = card
    addCorner(expandButton, 7)

    self.Window:_registerControl(control)
    self.Window:_registerAccent(function()
        if currentMainModel and not items[currentIndex].Model and not items[currentIndex].Color then
            for _, part in ipairs(currentMainModel:GetDescendants()) do
                if part:IsA("BasePart") then part.Color = window.Theme.Accent end
            end
        end
        if currentExpandedModel and not items[currentIndex].Model and not items[currentIndex].Color then
            for _, part in ipairs(currentExpandedModel:GetDescendants()) do
                if part:IsA("BasePart") then part.Color = window.Theme.Accent end
            end
        end
        valueLabel.TextColor3 = window.Theme.Accent
        modalStroke.Color = window.Theme.Accent
        expandButton.BackgroundColor3 = window.Theme.Accent2 or window.Theme.Accent
        selectButton.BackgroundColor3 = window.Theme.Accent2 or window.Theme.Accent
    end)
    self.Window:_connect(previousButton.MouseButton1Click, function() control:Previous() end)
    self.Window:_connect(nextButton.MouseButton1Click, function() control:Next() end)
    self.Window:_connect(modalPrevious.MouseButton1Click, function() control:Previous() end)
    self.Window:_connect(modalNext.MouseButton1Click, function() control:Next() end)
    self.Window:_connect(expandButton.MouseButton1Click, function() control:OpenExpanded() end)
    self.Window:_connect(mainViewport.InputBegan, function(input)
        if isPointerInput(input) then control:OpenExpanded() end
    end)
    self.Window:_connect(closeButton.MouseButton1Click, function() control:CloseExpanded() end)
    self.Window:_connect(selectButton.MouseButton1Click, function() control:Select() end)
    self.Window:_connect(RunService.RenderStepped, function()
        local angle = os.clock() * (tonumber(config.RotationSpeed) or 0.65)
        local itemRotation = math.rad(tonumber(items[currentIndex].RotationY) or 0)
        if currentMainModel and currentMainModel.Parent then
            currentMainModel:PivotTo(CFrame.Angles(0, angle, 0) * currentMainRotation * CFrame.Angles(0, itemRotation, 0))
        end
        if backdrop.Visible and currentExpandedModel and currentExpandedModel.Parent then
            currentExpandedModel:PivotTo(CFrame.Angles(0, angle, 0) * currentExpandedRotation * CFrame.Angles(0, itemRotation, 0))
        end
    end)
    refresh(true)
    return control
end

function Window:Notify(message, duration)
    if self._destroyed or not self._notificationsEnabled then return end
    local theme = self.Theme
    local toast = Instance.new("Frame")
    toast.Name = "LibreUINotification"
    toast.AnchorPoint = Vector2.new(1, 0)
    toast.Position = UDim2.new(1, -18, 0, 18)
    toast.Size = UDim2.fromOffset(250, 48)
    toast.BackgroundColor3 = theme.Surface
    toast.BorderSizePixel = 0
    toast.ZIndex = 30
    toast.Parent = self.Gui
    addCorner(toast, 9)
    addStroke(toast, theme.Accent, 1)

    local label = makeText(toast, tostring(message), 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(1, -24, 1, 0)
    label.TextWrapped = true
    label.ZIndex = 31

    task.delay(math.max(tonumber(duration) or 2.5, 0.5), function()
        if toast.Parent then toast:Destroy() end
    end)
end

function Window:Open()
    if not self._destroyed then self.Frame.Visible = true end
end

function Window:Close()
    if not self._destroyed then
        self.Frame.Visible = false
        for _, overlay in ipairs(self._overlays) do overlay.Visible = false end
    end
end

function Window:Toggle()
    if self._destroyed then return end
    if self.Frame.Visible then self:Close() else self:Open() end
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, connection in ipairs(self._connections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(self._connections)
    if self.Gui then self.Gui:Destroy() end
end

function Library:CreateWindow(options)
    options = options or {}
    local player = Players.LocalPlayer
    assert(player, "LibreUI: CreateWindow deve ser chamada por um LocalScript")
    local playerGui = player:WaitForChild("PlayerGui")
    local theme = copyTheme(options)
    local initialTheme = {}
    for key, value in pairs(theme) do initialTheme[key] = value end
    local shortcut = options.Shortcut
    if shortcut == nil then shortcut = Enum.KeyCode.RightShift end
    if shortcut == false then shortcut = nil end
    assert(shortcut == nil or (typeof(shortcut) == "EnumItem" and shortcut.EnumType == Enum.KeyCode), "Shortcut precisa ser Enum.KeyCode, false ou nil")

    local window = setmetatable({
        Theme = theme,
        _initialTheme = initialTheme,
        Tabs = {},
        Controls = {},
        _accentRenderers = {},
        _connections = {},
        _overlays = {},
        _activeTab = nil,
        _destroyed = false,
        _player = player,
        _baseAccent = theme.Accent,
        _initialAccent = theme.Accent,
        _rgbEnabled = options.RGB == true,
        _defaultRGBEnabled = options.RGB == true,
        _defaultShortcut = shortcut,
        Shortcut = shortcut,
        _notificationsEnabled = options.Notifications ~= false,
        _defaultNotificationsEnabled = options.Notifications ~= false,
        _listeningKeybind = false,
    }, Window)

    local gui = Instance.new("ScreenGui")
    gui.Name = options.Name or DEFAULTS.Name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = tonumber(options.DisplayOrder) or 30
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    window.Gui = gui

    local frame = Instance.new("Frame")
    frame.Name = "LibreUIWindow"
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = options.Position or UDim2.fromScale(0.5, 0.5)
    frame.Size = options.Size or DEFAULTS.Size
    frame.BackgroundColor3 = theme.Background
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = gui
    addCorner(frame, 14)
    local frameStroke = addStroke(frame, theme.Accent, 2)
    frameStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    window.Frame = frame
    window._frame = frame
    window._frameStroke = frameStroke

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 58)
    header.BackgroundTransparency = 1
    header.Active = true
    header.Parent = frame

    local logo = Instance.new("Frame")
    logo.Name = "AccentMark"
    logo.Size = UDim2.fromOffset(4, 26)
    logo.Position = UDim2.new(0, 15, 0.5, -13)
    logo.BackgroundColor3 = theme.Accent
    logo.BorderSizePixel = 0
    logo.Parent = header
    addCorner(logo, 3)
    window._logoMark = logo
    window._header = header

    local title = makeText(header, options.Title or DEFAULTS.Title, 14, theme.Text, Enum.Font.GothamBlack)
    title.Position = UDim2.new(0, 28, 0, 8)
    title.Size = UDim2.new(0, 230, 0, 22)
    window._titleLabel = title

    local subtitle = makeText(header, options.Subtitle or DEFAULTS.Subtitle, 8, theme.Muted, Enum.Font.GothamBold)
    subtitle.Position = UDim2.new(0, 29, 0, 31)
    subtitle.Size = UDim2.new(0, 260, 0, 14)
    window._subtitleLabel = subtitle

    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.fromOffset(30, 30)
    closeButton.Position = UDim2.new(1, -43, 0, 14)
    closeButton.BackgroundColor3 = theme.Surface2
    closeButton.Text = "X"
    closeButton.TextColor3 = theme.Muted
    closeButton.TextSize = 15
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = header
    addCorner(closeButton, 8)
    window:_connect(closeButton.MouseButton1Click, function()
        window:Close()
    end)

    local divider = Instance.new("Frame")
    divider.Name = "HeaderDivider"
    divider.Size = UDim2.new(1, -20, 0, 1)
    divider.Position = UDim2.new(0, 10, 0, 58)
    divider.BackgroundColor3 = theme.Surface2
    divider.BorderSizePixel = 0
    divider.Parent = frame
    window._headerDivider = divider
    window:_registerAccent(function()
        title.TextColor3 = theme.Text
        subtitle.TextColor3 = theme.Muted
        closeButton.BackgroundColor3 = theme.Surface2
        closeButton.TextColor3 = theme.Muted
    end)

    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Position = UDim2.new(0, 12, 0, 70)
    sidebar.Size = UDim2.new(0, 145, 1, -82)
    sidebar.BackgroundTransparency = 1
    sidebar.Parent = frame
    window.Sidebar = sidebar

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Padding = UDim.new(0, 5)
    sidebarLayout.Parent = sidebar
    local sidebarPadding = Instance.new("UIPadding")
    sidebarPadding.PaddingBottom = UDim.new(0, 62)
    sidebarPadding.Parent = sidebar

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Position = UDim2.new(0, 166, 0, 70)
    content.Size = UDim2.new(1, -178, 1, -82)
    content.BackgroundTransparency = 1
    content.ClipsDescendants = true
    content.Parent = frame
    window.Content = content

    if options.Profile ~= false then window:SetProfile(options.Profile) end
    window:SetResizable(options.Resizable == nil and true or options.Resizable, options.MinSize, options.MaxSize)

    window:_connect(UserInputService.InputBegan, function(input, processed)
        if processed or window._listeningKeybind then return end
        if window.Shortcut and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == window.Shortcut then
            window:Toggle()
        end
    end)
    window:_connect(RunService.RenderStepped, function(dt)
        if not window._rgbEnabled then return end
        window._hue = ((window._hue or 0) + dt * 0.045) % 1
        local accent = Color3.fromHSV(window._hue, 0.82, 1)
        window.Theme.Accent = accent
        window.Theme.Accent2 = accent
        window:_refreshAccent()
    end)

    local dragging = false
    local dragStart
    local startPosition
    window:_connect(header.InputBegan, function(input)
        local beforeClose = header.AbsolutePosition.X + header.AbsoluteSize.X - 52
        if isPointerInput(input) and input.Position.X <= beforeClose then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end)
    window:_connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
    window:_connect(UserInputService.InputEnded, function(input)
        if isPointerInput(input) then dragging = false end
    end)

    return window
end

return Library
