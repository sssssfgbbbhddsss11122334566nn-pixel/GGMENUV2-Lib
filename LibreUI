        modalMenu = createOptionMenu(
            modal,
            "ModalObjectSelectorList",
            UDim2.new(0, 14, 0, 73),
            UDim2.new(1, -28, 0, math.min(#items, 6) * 29 + 6),
            45,
            modalOptionButtons
        )
        table.insert(window._overlays, mainMenu)
