        local angle = os.clock() * (tonumber(config.RotationSpeed) or 0.65)
        local itemRotation = math.rad(tonumber(items[currentIndex].RotationY) or 0)
        if currentMainModel and currentMainModel.Parent then
            currentMainModel:PivotTo(CFrame.Angles(0, angle, 0) * currentMainRotation * CFrame.Angles(0, itemRotation, 0))
        end
        if backdrop.Visible and currentExpandedModel and currentExpandedModel.Parent then
            currentExpandedModel:PivotTo(CFrame.Angles(0, angle, 0) * currentExpandedRotation * CFrame.Angles(0, itemRotation, 0))
        end
    end)
    refresh(true)
    return control
end

function Tab:AddObjectSelector(config)
    config = config or {}
    local selectorConfig = {}
    for key, value in pairs(config) do selectorConfig[key] = value end
    selectorConfig.Items = config.Items or config.Objects
    selectorConfig.ShowListSelector = true
    selectorConfig.Name = config.Name or "SELETOR DE OBJETO 3D"
    selectorConfig.ExpandText = config.ExpandText or "ABRIR SELETOR 3D"
    selectorConfig.SelectText = config.SelectText or "SELECIONAR OBJETO"
    return self:Add3DPreview(selectorConfig)
end

function Window:Notify(message, duration)
    if self._destroyed or not self._notificationsEnabled then return end
    local theme = self.Theme
    local toast = Instance.new("Frame")
    toast.Name = "LibreUINotification"
    toast.AnchorPoint = Vector2.new(1, 0)
    toast.Position = UDim2.new(1, -18, 0, 18)
    toast.Size = UDim2.fromOffset(250, 48)
    toast.BackgroundColor3 = theme.Surface
    toast.BorderSizePixel = 0
    toast.ZIndex = 30
    toast.Parent = self.Gui
    addCorner(toast, 9)
    addStroke(toast, theme.Accent, 1)

    local label = makeText(toast, tostring(message), 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(1, -24, 1, 0)
    label.TextWrapped = true
    label.ZIndex = 31

    task.delay(math.max(tonumber(duration) or 2.5, 0.5), function()
        if toast.Parent then toast:Destroy() end
    end)
end

function Window:Open()
    if not self._destroyed then self.Frame.Visible = true end
end

function Window:Close()
    if not self._destroyed then
        self.Frame.Visible = false
        for _, overlay in ipairs(self._overlays) do overlay.Visible = false end
    end
end

function Window:Toggle()
    if self._destroyed then return end
    if self.Frame.Visible then self:Close() else self:Open() end
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, connection in ipairs(self._connections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(self._connections)
    if self.Gui then self.Gui:Destroy() end
end

function Library:CreateWindow(options)
    options = options or {}
    local player = Players.LocalPlayer
    assert(player, "LibreUI: CreateWindow deve ser chamada por um LocalScript")
    local playerGui = player:WaitForChild("PlayerGui")
    local theme = copyTheme(options)
    local initialTheme = {}
    for key, value in pairs(theme) do initialTheme[key] = value end
    local shortcut = options.Shortcut
    if shortcut == nil then shortcut = Enum.KeyCode.RightShift end
    if shortcut == false then shortcut = nil end
    assert(shortcut == nil or (typeof(shortcut) == "EnumItem" and shortcut.EnumType == Enum.KeyCode), "Shortcut precisa ser Enum.KeyCode, false ou nil")
    local launcherConfig = type(options.Launcher) == "table" and options.Launcher or { Icon = "⚙", Text = "" }
    local launcherEnabled = options.Launcher ~= false and not (type(options.Launcher) == "table" and options.Launcher.Enabled == false)

    local window = setmetatable({
        Theme = theme,
        _initialTheme = initialTheme,
        Tabs = {},
        Controls = {},
        _accentRenderers = {},
        _connections = {},
        _overlays = {},
        _activeTab = nil,
        _destroyed = false,
        _player = player,
        _baseAccent = theme.Accent,
        _initialAccent = theme.Accent,
        _rgbEnabled = options.RGB == true,
        _defaultRGBEnabled = options.RGB == true,
        _defaultShortcut = shortcut,
        Shortcut = shortcut,
        _notificationsEnabled = options.Notifications ~= false,
        _defaultNotificationsEnabled = options.Notifications ~= false,
        _launcherEnabled = launcherEnabled,
        _defaultLauncherEnabled = launcherEnabled,
        _launcherConfig = launcherConfig,
        _listeningKeybind = false,
    }, Window)

    local gui = Instance.new("ScreenGui")
    gui.Name = options.Name or DEFAULTS.Name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = tonumber(options.DisplayOrder) or 30
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    window.Gui = gui
    if window._launcherEnabled then window:CreateLauncher(launcherConfig) end

    local frame = Instance.new("Frame")
    frame.Name = "LibreUIWindow"
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = options.Position or UDim2.fromScale(0.5, 0.5)
    frame.Size = options.Size or DEFAULTS.Size
    frame.BackgroundColor3 = theme.Background
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = gui
    addCorner(frame, 14)
    local frameStroke = addStroke(frame, theme.Accent, 2)
    frameStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    window.Frame = frame
    window._frame = frame
    window._frameStroke = frameStroke

    local header = Instance.new("Frame")
