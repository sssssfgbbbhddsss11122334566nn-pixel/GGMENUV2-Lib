    local function makeModel(world, item)
        for _, child in ipairs(world:GetChildren()) do child:Destroy() end
        local model
        if typeof(item.Model) == "Instance" then
            local ok, cloned = pcall(function() return item.Model:Clone() end)
            if ok and cloned then
                if cloned:IsA("Model") then
                    model = cloned
                elseif cloned:IsA("BasePart") then
                    model = Instance.new("Model")
                    cloned.Parent = model
                    model.PrimaryPart = cloned
                else
                    cloned:Destroy()
                end
            end
        end

        if not model then
            model = Instance.new("Model")
            local part = Instance.new("Part")
            part.Name = "PreviewShape"
            local shape = item.Shape
            if typeof(shape) ~= "EnumItem" or shape.EnumType ~= Enum.PartType then shape = Enum.PartType.Block end
            local size = typeof(item.Size) == "Vector3" and item.Size or Vector3.new(1.7, 1.7, 1.7)
            part.Shape = shape
            part.Size = size
            part.Color = typeof(item.Color) == "Color3" and item.Color or window.Theme.Accent
            local material = item.Material
            if typeof(material) ~= "EnumItem" or material.EnumType ~= Enum.Material then material = Enum.Material.SmoothPlastic end
            part.Material = material
            part.Anchored = true
            part.CanCollide = false
            part.Parent = model
            model.PrimaryPart = part
        end

        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") or descendant:IsA("Tool") then
                descendant:Destroy()
            end
        end
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
                if not item.Model and typeof(item.Color) == "Color3" then descendant.Color = item.Color end
            end
        end
        model.Name = tostring(item.Name or "Preview")
        model.Parent = world
        local baseRotation = CFrame.new()
        pcall(function()
            local pivot = model:GetPivot()
            local boundsCFrame = model:GetBoundingBox()
            local centeredPivot = CFrame.new(-boundsCFrame.Position) * pivot
            model:PivotTo(centeredPivot)
            baseRotation = centeredPivot.Rotation
        end)
        return model, baseRotation
    end

    local function fitModel(model, camera, minimumDistance)
        if not model or not camera then return end
        pcall(function()
            local bounds = model:GetExtentsSize()
            local largestSide = math.max(bounds.X, bounds.Y, bounds.Z)
            local distance = math.max(minimumDistance, largestSide * 1.45)
            camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
        end)
    end

    local initialIndex = math.clamp(math.floor(tonumber(config.DefaultIndex) or 1), 1, #items)
    local currentIndex = initialIndex
    local currentMainModel
    local currentExpandedModel
    local currentMainRotation = CFrame.new()
    local currentExpandedRotation = CFrame.new()
    local mainMenu
    local modalMenu
    local renderSelector
    local function refresh(silent)
        local item = items[currentIndex]
        local itemName = tostring(item.Name or ("Item " .. currentIndex))
        valueLabel.Text = itemName .. "  (" .. currentIndex .. "/" .. #items .. ")"
        modalTitle.Text = string.upper(itemName)
        if showListSelector then
            listButton.Text = itemName .. "   v"
            selectedLabel.Text = "SELECIONADO: " .. itemName .. "  |  " .. currentIndex .. "/" .. #items
            modalListButton.Text = itemName .. "   v"
            modalSelectedLabel.Text = "SELECIONADO: " .. itemName .. "  |  " .. currentIndex .. "/" .. #items
            if renderSelector then renderSelector() end
        end
        currentMainModel, currentMainRotation = makeModel(mainWorld, item)
        currentExpandedModel, currentExpandedRotation = makeModel(expandedWorld, item)
        fitModel(currentMainModel, mainCamera, tonumber(config.CameraDistance) or 5.4)
        fitModel(currentExpandedModel, expandedCamera, tonumber(config.ExpandedCameraDistance) or 6.4)
        if not silent then invoke(config.OnChanged, item, currentIndex) end
    end
    local control = { Instance = card, Value = items[currentIndex], Items = items, SelectedIndex = currentIndex }
    function control:SetIndex(index, silent)
        local numericIndex = tonumber(index)
        if not numericIndex then return end
        currentIndex = ((math.floor(numericIndex) - 1) % #items) + 1
        control.Value = items[currentIndex]
        control.SelectedIndex = currentIndex
        refresh(silent)
    end
    function control:SetValue(value, silent)
        if type(value) == "number" then
            control:SetIndex(value, silent)
            return
        end
        for index, item in ipairs(items) do
            if item == value or tostring(item.Name or "") == tostring(value) then
                control:SetIndex(index, silent)
                return
            end
        end
    end
    function control:Next()
        control:SetIndex(currentIndex + 1)
    end
    function control:Previous()
        control:SetIndex(currentIndex - 1)
    end
    function control:GetValue()
