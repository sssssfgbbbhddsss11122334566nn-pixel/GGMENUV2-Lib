-- LibreUI - biblioteca local de componentes visuais para Roblox.
-- Use este arquivo como ModuleScript e faça require a partir de um LocalScript.
-- A biblioteca cria apenas UI; não carrega código remoto nem altera o mundo do jogo.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Library = {}
local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab

local DEFAULTS = {
    Title = "LIBRE UI",
    Subtitle = "LOCAL UI COMPONENTS",
    Name = "LibreUI",
    Size = UDim2.fromOffset(620, 420),
    Accent = Color3.fromRGB(40, 225, 151),
    Accent2 = Color3.fromRGB(0, 190, 130),
    Background = Color3.fromRGB(9, 13, 19),
    Surface = Color3.fromRGB(17, 22, 30),
    Surface2 = Color3.fromRGB(25, 31, 41),
    Text = Color3.fromRGB(238, 243, 247),
    Muted = Color3.fromRGB(145, 155, 168),
    Off = Color3.fromRGB(55, 63, 74),
    Track = Color3.fromRGB(43, 53, 64),
}

local function copyTheme(options)
    local theme = {}
    for key, value in pairs(DEFAULTS) do
        theme[key] = options[key] ~= nil and options[key] or value
    end
    return theme
end

local function addCorner(parent, radius)
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, radius)
    uiCorner.Parent = parent
    return uiCorner
end

local function addStroke(parent, color, thickness)
    local uiStroke = Instance.new("UIStroke")
    uiStroke.Color = color
    uiStroke.Thickness = thickness or 1
    uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    uiStroke.LineJoinMode = Enum.LineJoinMode.Round
    uiStroke.Parent = parent
    return uiStroke
end

local function makeText(parent, value, size, color, font)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = value or ""
    label.TextColor3 = color
    label.TextSize = size or 10
    label.Font = font or Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

local function isPointerInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function invoke(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[LibreUI] Erro no callback: " .. tostring(err))
    end
end

local function shorten(value, limit)
    value = tostring(value or "")
    if #value > limit then return string.sub(value, 1, limit - 3) .. "..." end
    return value
end

local function iconAsset(icon)
    if type(icon) == "number" then return "rbxassetid://" .. tostring(math.floor(icon)) end
    if type(icon) ~= "string" then return nil end
    if string.match(icon, "^%d+$") then return "rbxassetid://" .. icon end
    if string.match(icon, "^rbxassetid://") or string.match(icon, "^rbxthumb://") then return icon end
    return nil
end

local function createAvatarCard(window, parent, options, position, size)
    options = type(options) == "table" and options or {}
    local player = options.Player or window._player
    local userId = tonumber(options.UserId) or (player and player.UserId)
    local displayName = shorten(options.DisplayName or (player and player.DisplayName) or (userId and ("User " .. userId)) or "Guest", 12)
    local username = shorten(options.Username or (player and player.Name) or (userId and tostring(userId)) or "", 12)

    local card = Instance.new("Frame")
    card.Name = options.Name or "AvatarCard"
    card.Position = position
    card.Size = size
    card.BackgroundColor3 = window.Theme.Surface2
    card.BorderSizePixel = 0
    card.Parent = parent
    addCorner(card, options.CornerRadius or 8)
    addStroke(card, window.Theme.Track or window.Theme.Surface, 1)

    local portraitSize = math.clamp(size.Y.Offset - 16, 32, 52)
    local image = Instance.new("ImageLabel")
    image.Name = "AvatarImage"
    image.Size = UDim2.fromOffset(portraitSize, portraitSize)
    image.Position = UDim2.new(0, 7, 0.5, -portraitSize / 2)
    image.BackgroundColor3 = window.Theme.Surface
    image.BorderSizePixel = 0
    image.Image = ""
    image.Parent = card
    addCorner(image, 7)

    local initialsText = string.upper(string.sub(displayName, 1, 1))
    local fallback = makeText(image, initialsText, 14, window.Theme.Accent, Enum.Font.GothamBold)
    fallback.Size = UDim2.fromScale(1, 1)
    fallback.TextXAlignment = Enum.TextXAlignment.Center
    fallback.TextYAlignment = Enum.TextYAlignment.Center
    fallback.ZIndex = 2

    local infoX = portraitSize + 14
    local nameLabel = makeText(card, displayName, 9, window.Theme.Text, Enum.Font.GothamBold)
    nameLabel.Position = UDim2.new(0, infoX, 0, 8)
    nameLabel.Size = UDim2.new(1, -infoX - 5, 0, 15)
    local handleLabel = makeText(card, "@" .. username, 8, window.Theme.Accent, Enum.Font.GothamMedium)
    handleLabel.Position = UDim2.new(0, infoX, 0, 25)
    handleLabel.Size = UDim2.new(1, -infoX - 5, 0, 14)

    if options.Image then
        image.Image = tostring(options.Image)
        fallback.Visible = false
    elseif options.ShowThumbnail ~= false and userId then
        task.spawn(function()
            for _ = 1, 4 do
                local ok, imageUrl, ready = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        userId,
                        options.ThumbnailType or Enum.ThumbnailType.HeadShot,
                        options.ThumbnailSize or Enum.ThumbnailSize.Size100x100
                    )
                end)
                if ok and ready and image.Parent then
                    image.Image = imageUrl
                    fallback.Visible = false
                    break
                end
                task.wait(0.4)
            end
        end)
    end

    window:_registerAccent(function()
        card.BackgroundColor3 = window.Theme.Surface2
        image.BackgroundColor3 = window.Theme.Surface
        nameLabel.TextColor3 = window.Theme.Text
        handleLabel.TextColor3 = window.Theme.Accent
        fallback.TextColor3 = window.Theme.Accent
    end)
    return card
end

function Window:SetProfile(options)
    if self._profileCard then
        self._profileCard:Destroy()
        self._profileCard = nil
    end
    if options == false then return nil end
    options = type(options) == "table" and options or {}
    self._profileCard = createAvatarCard(
        self,
        self.Frame,
        options,
        UDim2.new(0, 12, 1, -66),
        UDim2.new(0, 145, 0, 54)
    )
    self._profileCard.Name = "ProfileCard"
    return self._profileCard
end

function Window:AddProfileCard(options)
    return self:SetProfile(options)
end

function Window:SetTitle(value)
    if self._titleLabel then self._titleLabel.Text = tostring(value or "") end
end

function Window:SetSubtitle(value)
    if self._subtitleLabel then self._subtitleLabel.Text = tostring(value or "") end
end

function Window:_connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self._connections, connection)
    return connection
end

function Window:_registerControl(control)
    table.insert(self.Controls, control)
    return control
end

function Window:_registerAccent(renderer)
    table.insert(self._accentRenderers, renderer)
    renderer()
end

function Window:_refreshAccent()
    if self._frameStroke then self._frameStroke.Color = self.Theme.Accent end
    if self._logoMark then self._logoMark.BackgroundColor3 = self.Theme.Accent end
    if self._frame then self._frame.BackgroundColor3 = self.Theme.Background end
    if self._headerDivider then self._headerDivider.BackgroundColor3 = self.Theme.Surface2 end
    if self._resizeHandle then self._resizeHandle.TextColor3 = self.Theme.Muted end
    for _, renderer in ipairs(self._accentRenderers) do
        invoke(renderer)
    end
end

function Window:SetAccent(color)
    assert(typeof(color) == "Color3", "SetAccent espera uma Color3")
    self._baseAccent = color
    if not self._rgbEnabled then self.Theme.Accent = color end
    self:_refreshAccent()
end

function Window:SetRGBEnabled(enabled)
    self._rgbEnabled = enabled == true
    if not self._rgbEnabled then
        self.Theme.Accent = self._baseAccent
        self:_refreshAccent()
    end
end

function Window:SetShortcut(keyCode)
    assert(keyCode == nil or (typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode), "SetShortcut espera um Enum.KeyCode ou nil")
    self.Shortcut = keyCode
end

function Window:SetToggleKey(keyCode)
    self:SetShortcut(keyCode)
end

function Window:Reset()
    for _, control in ipairs(self.Controls) do
        if control.Reset then control:Reset() end
    end
end

function Window:ResetDefaults(silent)
    for key, value in pairs(self._initialTheme) do self.Theme[key] = value end
    self._baseAccent = self._initialTheme.Accent
    self:SetRGBEnabled(self._defaultRGBEnabled)
    self:SetAccent(self._initialAccent)
    self:SetShortcut(self._defaultShortcut)
    self:SetNotificationsEnabled(self._defaultNotificationsEnabled)
    for _, control in ipairs(self.Controls) do
        if control.Reset then control:Reset(silent) end
    end
    self:_refreshAccent()
end

function Window:SetNotificationsEnabled(enabled)
    self._notificationsEnabled = enabled == true
end

function Window:SetTheme(themeOptions)
    themeOptions = themeOptions or {}
    local colorKeys = {
        Accent = true, Accent2 = true, Background = true, Surface = true,
        Surface2 = true, Text = true, Muted = true, Off = true, Track = true,
    }
    for key, value in pairs(themeOptions) do
        if colorKeys[key] and typeof(value) == "Color3" then self.Theme[key] = value end
    end
    if typeof(themeOptions.Accent) == "Color3" then self._baseAccent = themeOptions.Accent end
    if not self._rgbEnabled then self.Theme.Accent = self._baseAccent end
    self:_refreshAccent()
end

function Window:SetResizable(enabled, minSize, maxSize)
    if type(enabled) == "table" then
        local options = enabled
        enabled = options.Enabled ~= false
        minSize = options.MinSize or minSize
        maxSize = options.MaxSize or maxSize
    end
    self._resizable = enabled ~= false
    self._minSize = typeof(minSize) == "Vector2" and minSize or Vector2.new(500, 340)
    self._maxSize = typeof(maxSize) == "Vector2" and maxSize or Vector2.new(860, 680)
    self._maxSize = Vector2.new(math.max(self._maxSize.X, self._minSize.X), math.max(self._maxSize.Y, self._minSize.Y))

    if self._resizeHandle then
        self._resizeHandle.Visible = self._resizable
        return self._resizeHandle
    end
    if not self._resizable then return nil end

    local handle = Instance.new("TextButton")
    handle.Name = "ResizeHandle"
    handle.Size = UDim2.fromOffset(22, 22)
    handle.Position = UDim2.new(1, -28, 1, -28)
    handle.BackgroundTransparency = 1
    handle.Text = "///"
    handle.TextColor3 = self.Theme.Muted
    handle.TextSize = 7
    handle.TextXAlignment = Enum.TextXAlignment.Right
    handle.Font = Enum.Font.GothamBold
    handle.Active = true
    handle.ZIndex = 8
    handle.Parent = self.Frame
    self._resizeHandle = handle

    local resizing = false
    local dragInput
    local startPoint
    local startSize
    self:_connect(handle.InputBegan, function(input)
        if self._resizable and isPointerInput(input) then
            resizing = true
            dragInput = input
            startPoint = input.Position
            startSize = self.Frame.AbsoluteSize
        end
    end)
    self:_connect(UserInputService.InputChanged, function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput) then
            local delta = input.Position - startPoint
            local width = math.clamp(startSize.X + delta.X, self._minSize.X, self._maxSize.X)
            local height = math.clamp(startSize.Y + delta.Y, self._minSize.Y, self._maxSize.Y)
            self.Frame.Size = UDim2.fromOffset(width, height)
        end
    end)
    self:_connect(UserInputService.InputEnded, function(input)
        if isPointerInput(input) then resizing = false end
    end)
    return handle
end

function Window:CreateLauncher(config)
    config = config or {}
    local launcher = Instance.new("TextButton")
    launcher.Name = config.Name or "LibreUILauncher"
    launcher.Size = config.Size or UDim2.fromOffset(44, 44)
    launcher.Position = config.Position or UDim2.new(0, 18, 0.5, -22)
    launcher.BackgroundColor3 = self.Theme.Accent
    local launcherIcon = iconAsset(config.Icon)
    launcher.Text = launcherIcon and (config.Text or "") or (config.Icon and tostring(config.Icon) or config.Text or "UI")
    launcher.TextColor3 = Color3.fromRGB(5, 18, 18)
    launcher.TextSize = tonumber(config.TextSize) or 12
    launcher.Font = Enum.Font.GothamBlack
    launcher.Active = true
    launcher.Parent = self.Gui
    addCorner(launcher, 12)
    addStroke(launcher, self.Theme.Accent, 1)
    local iconImage
    if launcherIcon then
        iconImage = Instance.new("ImageLabel")
        iconImage.Name = "LauncherIcon"
        local hasLabel = config.Text ~= nil and tostring(config.Text) ~= ""
        local iconSize = hasLabel and 16 or 20
        iconImage.Size = UDim2.fromOffset(iconSize, iconSize)
        iconImage.Position = hasLabel and UDim2.new(0, 7, 0.5, -iconSize / 2) or UDim2.new(0.5, -10, 0.5, -10)
        iconImage.BackgroundTransparency = 1
        iconImage.Image = launcherIcon
        iconImage.ImageColor3 = Color3.fromRGB(5, 18, 18)
        iconImage.ZIndex = 2
        iconImage.Parent = launcher
        if hasLabel then
            local padding = Instance.new("UIPadding")
            padding.PaddingLeft = UDim.new(0, 20)
            padding.Parent = launcher
        end
    end
    self:_registerAccent(function()
        launcher.BackgroundColor3 = self.Theme.Accent
        if iconImage then iconImage.ImageColor3 = Color3.fromRGB(5, 18, 18) end
    end)
    self:_connect(launcher.MouseButton1Click, function()
        self:Toggle()
    end)

    local dragging = false
    local dragStart
    local startPosition
    self:_connect(launcher.InputBegan, function(input)
        if isPointerInput(input) then
            dragging = true
            dragStart = input.Position
            startPosition = launcher.Position
        end
    end)
    self:_connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            launcher.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
    self:_connect(UserInputService.InputEnded, function(input)
        if isPointerInput(input) then dragging = false end
    end)
    return launcher
end

function Window:_selectTab(targetTab)
    self._activeTab = targetTab
    for _, tab in ipairs(self.Tabs) do
        local selected = tab == targetTab
        tab.Page.Visible = selected
        tab.Button.BackgroundColor3 = selected and self.Theme.Surface2 or self.Theme.Surface
        tab.Button.TextColor3 = selected and self.Theme.Text or self.Theme.Muted
        if tab.IconImage then tab.IconImage.ImageColor3 = selected and self.Theme.Accent or self.Theme.Muted end
    end
end

function Window:CreateTab(name)
    assert(not self._destroyed, "LibreUI: a janela já foi destruída")
    local icon
    if type(name) == "table" then
        icon = name.Icon
        name = name.Name
    end
    assert(type(name) == "string" and name ~= "", "CreateTab precisa de um nome")

    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. tostring(#self.Tabs + 1)
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = self.Theme.Accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = self.Content

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 2)
    padding.PaddingBottom = UDim.new(0, 8)
    padding.PaddingLeft = UDim.new(0, 3)
    padding.PaddingRight = UDim.new(0, 8)
    padding.Parent = page

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 7)
    pageLayout.Parent = page

    local button = Instance.new("TextButton")
    button.Name = "TabButton_" .. tostring(#self.Tabs + 1)
    button.Size = UDim2.new(1, -10, 0, 34)
    button.BackgroundColor3 = self.Theme.Surface
    button.BorderSizePixel = 0
    local imageIcon = iconAsset(icon)
    button.Text = imageIcon and name or (icon and (tostring(icon) .. "  " .. name) or name)
    button.TextColor3 = self.Theme.Muted
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.LayoutOrder = #self.Tabs + 1
    button.Parent = self.Sidebar
    addCorner(button, 7)

    local buttonPadding = Instance.new("UIPadding")
    buttonPadding.PaddingLeft = UDim.new(0, imageIcon and 32 or 12)
    buttonPadding.Parent = button
    local iconImage
    if imageIcon then
        iconImage = Instance.new("ImageLabel")
        iconImage.Name = "TabIcon"
        iconImage.Size = UDim2.fromOffset(14, 14)
        iconImage.Position = UDim2.new(0, 10, 0.5, -7)
        iconImage.BackgroundTransparency = 1
        iconImage.Image = imageIcon
        iconImage.ImageColor3 = self.Theme.Muted
        iconImage.ZIndex = 2
        iconImage.Parent = button
    end

    local tab = setmetatable({
        Name = name,
        Icon = icon,
        Window = self,
        Page = page,
        Button = button,
        IconImage = iconImage,
        _controlOrder = 0,
    }, Tab)
    table.insert(self.Tabs, tab)

    self:_connect(button.MouseButton1Click, function()
        self:_selectTab(tab)
    end)
    self:_registerAccent(function()
        local selected = self._activeTab == tab
        button.BackgroundColor3 = selected and self.Theme.Surface2 or self.Theme.Surface
        button.TextColor3 = selected and self.Theme.Text or self.Theme.Muted
        if iconImage then iconImage.ImageColor3 = selected and self.Theme.Accent or self.Theme.Muted end
        page.ScrollBarImageColor3 = self.Theme.Accent
    end)

    if not self._activeTab then
        self:_selectTab(tab)
    end
    return tab
end

function Tab:_makeRow(height)
    assert(not self.Window._destroyed, "LibreUI: a janela já foi destruída")
    self._controlOrder += 1

    local row = Instance.new("Frame")
    row.Name = "Control_" .. tostring(self._controlOrder)
    row.Size = UDim2.new(1, 0, 0, height)
    row.BackgroundColor3 = self.Window.Theme.Surface
    row.BackgroundTransparency = 0.04
    row.BorderSizePixel = 0
    row.LayoutOrder = self._controlOrder
    row.Parent = self.Page
    addCorner(row, 8)
    self.Window:_registerAccent(function()
        row.BackgroundColor3 = self.Window.Theme.Surface
    end)
    return row
end

function Tab:AddSection(title, description)
    local row = self:_makeRow(description and 46 or 26)
    row.BackgroundTransparency = 1
    local heading = makeText(row, string.upper(title or ""), 9, self.Window.Theme.Accent, Enum.Font.GothamBold)
    heading.Size = UDim2.new(1, 0, 0, 17)
    self.Window:_registerAccent(function()
        heading.TextColor3 = self.Window.Theme.Accent
    end)
    if description then
        local sub = makeText(row, description, 8, self.Window.Theme.Muted, Enum.Font.Gotham)
        sub.Position = UDim2.new(0, 0, 0, 19)
        sub.Size = UDim2.new(1, 0, 0, 17)
        self.Window:_registerAccent(function()
            sub.TextColor3 = self.Window.Theme.Muted
        end)
    end
    return row
end

function Tab:AddLabel(config)
    config = type(config) == "table" and config or { Name = tostring(config or "") }
    local row = self:_makeRow(config.Height or 34)
    local label = makeText(row, config.Name or "", config.TextSize or 10, self.Window.Theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 11, 0, 0)
    label.Size = UDim2.new(1, -22, 1, 0)
    self.Window:_registerAccent(function()
        label.TextColor3 = self.Window.Theme.Text
    end)
    return { Instance = row, Label = label }
end

function Tab:AddParagraph(config)
    config = config or {}
    local row = self:_makeRow(tonumber(config.Height) or 58)
    local title = makeText(row, config.Title or config.Name or "", 10, self.Window.Theme.Text, Enum.Font.GothamBold)
    title.Position = UDim2.new(0, 11, 0, 6)
    title.Size = UDim2.new(1, -22, 0, 17)
    local body = makeText(row, config.Content or config.Description or "", 8, self.Window.Theme.Muted, Enum.Font.Gotham)
    body.Position = UDim2.new(0, 11, 0, 24)
    body.Size = UDim2.new(1, -22, 1, -28)
    body.TextWrapped = true
    body.TextYAlignment = Enum.TextYAlignment.Top
    self.Window:_registerAccent(function()
        title.TextColor3 = self.Window.Theme.Text
        body.TextColor3 = self.Window.Theme.Muted
    end)
    return { Instance = row, Title = title, Body = body }
end

function Tab:AddInput(config)
    config = config or {}
    local theme = self.Window.Theme
    local initial = tostring(config.Default or "")
    local row = self:_makeRow(42)
    local label = makeText(row, config.Name or "Texto", 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 11, 0, 0)
    label.Size = UDim2.new(0.4, -10, 1, 0)

    local input = Instance.new("TextBox")
    input.Name = "TextInput"
    input.Size = UDim2.new(0.6, -18, 0, 27)
    input.Position = UDim2.new(0.4, 0, 0.5, -13)
    input.BackgroundColor3 = theme.Surface2
    input.BorderSizePixel = 0
    input.ClearTextOnFocus = config.ClearOnFocus == true
    input.PlaceholderText = config.Placeholder or "Digite aqui..."
    input.PlaceholderColor3 = theme.Muted
    input.Text = initial
    input.TextColor3 = theme.Text
    input.TextSize = 9
    input.Font = Enum.Font.GothamMedium
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.Parent = row
    addCorner(input, 6)
    local inputPadding = Instance.new("UIPadding")
    inputPadding.PaddingLeft = UDim.new(0, 8)
    inputPadding.PaddingRight = UDim.new(0, 8)
    inputPadding.Parent = input

    local control = { Value = initial, Instance = row, TextBox = input }
    function control:SetValue(value, silent)
        local nextValue = tostring(value or "")
        local limit = tonumber(config.MaxLength)
        if limit and limit > 0 and #nextValue > limit then nextValue = string.sub(nextValue, 1, limit) end
        local changed = control.Value ~= nextValue
        control.Value = nextValue
        input.Text = nextValue
        if changed and not silent then invoke(config.Callback, nextValue) end
    end
    function control:GetValue()
        return control.Value
    end
    function control:Reset(silent)
        control:SetValue(initial, silent)
    end
    self.Window:_registerControl(control)
    self.Window:_registerAccent(function()
        label.TextColor3 = theme.Text
        input.BackgroundColor3 = theme.Surface2
        input.TextColor3 = theme.Text
        input.PlaceholderColor3 = theme.Muted
    end)
    if config.Live then
        self.Window:_connect(input:GetPropertyChangedSignal("Text"), function()
            control:SetValue(input.Text)
        end)
    else
        self.Window:_connect(input.FocusLost, function(enterPressed)
            control:SetValue(input.Text)
            if config.OnSubmit then invoke(config.OnSubmit, input.Text, enterPressed) end
        end)
    end
    return control
end

function Tab:AddTextBox(config)
    return self:AddInput(config)
end

function Tab:AddImage(config)
    config = config or {}
    local row = self:_makeRow(tonumber(config.Height) or 150)
    row.Name = config.Name or "ImageCard"
    local image = Instance.new("ImageLabel")
    image.Name = "ContentImage"
    image.Size = UDim2.new(1, -18, 1, -18)
    image.Position = UDim2.new(0, 9, 0, 9)
    image.BackgroundColor3 = self.Window.Theme.Surface2
    image.BorderSizePixel = 0
    image.ScaleType = config.ScaleType or Enum.ScaleType.Fit
    image.Image = tostring(config.Image or "")
