function Tab:AddSlider(config)
    config = config or {}
    local theme = self.Window.Theme
    local minimum = tonumber(config.Min) or 0
    local maximum = tonumber(config.Max) or 100
    if maximum <= minimum then
        maximum = minimum + 1
    end
    local step = tonumber(config.Step) or 1
    if step <= 0 then
        step = 1
    end
    local suffix = config.Suffix or ""
    local decimals = tonumber(config.Decimals)
    if decimals == nil then
        decimals = step < 1 and 2 or 0
    end
    decimals = math.clamp(math.floor(decimals), 0, 4)

    local row = self:_makeRow(60)
    local label = makeText(row, config.Name or "Slider", 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 11, 0, 4)
    label.Size = UDim2.new(1, -90, 0, 17)

    local valueLabel = makeText(row, "", 9, theme.Accent, Enum.Font.GothamBold)
    valueLabel.Position = UDim2.new(1, -72, 0, 4)
    valueLabel.Size = UDim2.fromOffset(60, 17)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("TextButton")
    track.Name = "SliderTrack"
    track.Size = UDim2.new(1, -22, 0, 7)
    track.Position = UDim2.new(0, 11, 0, 39)
    track.BackgroundColor3 = theme.Off
    track.Text = ""
    track.AutoButtonColor = false
    track.BorderSizePixel = 0
    track.Parent = row
    addCorner(track, 5)

    local fill = Instance.new("Frame")
    fill.Name = "SliderFill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    addCorner(fill, 5)

    local initial = tonumber(config.Default) or minimum
    local control = { Value = math.clamp(initial, minimum, maximum), Instance = row }
    local function formatValue(value)
        if decimals == 0 then
            return tostring(math.floor(value + 0.5))
        end
        return string.format("%." .. tostring(decimals) .. "f", value)
    end
    local function render()
        local fraction = (control.Value - minimum) / (maximum - minimum)
        fill.Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0)
        valueLabel.Text = formatValue(control.Value) .. tostring(suffix)
        label.TextColor3 = theme.Text
    end
    local function quantize(value)
        local stepped = minimum + math.floor((value - minimum) / step + 0.5) * step
        return math.clamp(stepped, minimum, maximum)
    end
    function control:SetValue(value, silent)
        local number = tonumber(value)
        if number == nil then return end
        local nextValue = quantize(number)
        local changed = nextValue ~= control.Value
        control.Value = nextValue
        render()
        if changed and not silent then invoke(config.Callback, control.Value) end
    end
    function control:GetValue()
        return control.Value
    end
    function control:Reset(silent)
        control:SetValue(initial, silent)
    end
    local function updateFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local fraction = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        control:SetValue(minimum + fraction * (maximum - minimum))
    end

    render()
    self.Window:_registerControl(control)
    self.Window:_registerAccent(function()
        fill.BackgroundColor3 = theme.Accent
        valueLabel.TextColor3 = theme.Accent
        track.BackgroundColor3 = theme.Off
    end)
    local dragging = false
    self.Window:_connect(track.InputBegan, function(input)
        if isPointerInput(input) then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    self.Window:_connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    self.Window:_connect(UserInputService.InputEnded, function(input)
        if isPointerInput(input) then
            dragging = false
        end
    end)
    return control
end

function Tab:AddDropdown(config)
    config = config or {}
    local options = config.Options or {}
    assert(type(options) == "table" and #options > 0, "AddDropdown precisa de Options com pelo menos um valor")
    local theme = self.Window.Theme
    local current = config.Default
    local currentIndex = table.find(options, current) or 1
    local initialIndex = currentIndex
    current = options[currentIndex]
    local menuMode = config.Mode == "Menu" or config.Expanded == true
    local baseHeight = 42
    local menuHeight = #options * 25

    local row = self:_makeRow(baseHeight)
    row.ClipsDescendants = menuMode
    local label = makeText(row, config.Name or "Opção", 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 11, 0, 0)
    label.Size = UDim2.new(0.45, -8, 1, 0)

    local choose = Instance.new("TextButton")
    choose.Name = "DropdownChoice"
    choose.Size = UDim2.new(0.55, -10, 0, 27)
    choose.Position = UDim2.new(0.45, 0, 0.5, -13)
    choose.BackgroundColor3 = theme.Surface2
    choose.TextColor3 = theme.Text
    choose.TextSize = 9
    choose.Font = Enum.Font.GothamMedium
    choose.Parent = row
    addCorner(choose, 6)

    local menu
    local optionButtons = {}
    if menuMode then
        menu = Instance.new("Frame")
        menu.Name = "DropdownMenu"
        menu.Position = UDim2.new(0, 9, 0, baseHeight)
        menu.Size = UDim2.new(1, -18, 0, menuHeight)
        menu.BackgroundColor3 = theme.Surface2
        menu.BorderSizePixel = 0
        menu.Visible = false
        menu.ZIndex = 4
        menu.Parent = row
        addCorner(menu, 6)
        for index, option in ipairs(options) do
            local optionButton = Instance.new("TextButton")
            optionButton.Name = "Option_" .. tostring(index)
            optionButton.Size = UDim2.new(1, 0, 0, 25)
            optionButton.Position = UDim2.new(0, 0, 0, (index - 1) * 25)
            optionButton.BackgroundColor3 = theme.Surface2
            optionButton.BorderSizePixel = 0
            optionButton.Text = tostring(option)
            optionButton.TextColor3 = theme.Text
            optionButton.TextSize = 9
            optionButton.Font = Enum.Font.GothamMedium
            optionButton.ZIndex = 5
            optionButton.Parent = menu
            table.insert(optionButtons, optionButton)
        end
    end

    local control = { Value = current, Instance = row }
    local function render()
        choose.Text = tostring(control.Value) .. (menuMode and (menu and menu.Visible and "   ^" or "   v") or "   >")
    end
    function control:SetValue(value, silent)
        local index = table.find(options, value)
        if not index then return end
        local changed = control.Value ~= value
        currentIndex = index
        control.Value = value
        render()
        if changed and not silent then invoke(config.Callback, control.Value) end
    end
    function control:GetValue()
        return control.Value
    end
    function control:Reset(silent)
        control:SetValue(options[initialIndex], silent)
        if menuMode then
            menu.Visible = false
            row.Size = UDim2.new(1, 0, 0, baseHeight)
            render()
        end
    end
    render()
    self.Window:_registerControl(control)
    self.Window:_registerAccent(function()
        choose.BackgroundColor3 = theme.Surface2
        choose.TextColor3 = theme.Text
        label.TextColor3 = theme.Text
        if menu then menu.BackgroundColor3 = theme.Surface2 end
        for _, optionButton in ipairs(optionButtons) do
            optionButton.BackgroundColor3 = theme.Surface2
            optionButton.TextColor3 = theme.Text
        end
    end)

    self.Window:_connect(choose.MouseButton1Click, function()
        if menuMode then
            if menu.Visible then
                menu.Visible = false
                row.Size = UDim2.new(1, 0, 0, baseHeight)
            else
                menu.Visible = true
                row.Size = UDim2.new(1, 0, 0, baseHeight + menuHeight)
            end
            render()
        else
            currentIndex = currentIndex % #options + 1
            control:SetValue(options[currentIndex])
        end
    end)
    if menuMode then
        for index, optionButton in ipairs(optionButtons) do
            self.Window:_connect(optionButton.MouseButton1Click, function()
                control:SetValue(options[index])
                menu.Visible = false
                row.Size = UDim2.new(1, 0, 0, baseHeight)
                render()
            end)
        end
    end
    return control
end

function Tab:AddThemePicker(config)
    config = config or {}
    local presets = config.Options or {
        { Name = "Verde", Accent = Color3.fromRGB(40, 225, 151), Accent2 = Color3.fromRGB(0, 190, 130) },
        { Name = "Ciano", Accent = Color3.fromRGB(40, 195, 245), Accent2 = Color3.fromRGB(0, 145, 205) },
        { Name = "Roxo", Accent = Color3.fromRGB(165, 95, 245), Accent2 = Color3.fromRGB(115, 55, 205) },
        { Name = "Rosa", Accent = Color3.fromRGB(245, 90, 165), Accent2 = Color3.fromRGB(205, 50, 125) },
        { Name = "Laranja", Accent = Color3.fromRGB(250, 155, 55), Accent2 = Color3.fromRGB(215, 105, 25) },
    }
    assert(type(presets) == "table" and #presets > 0, "AddThemePicker precisa de presets")
    local names = {}
    local byName = {}
    for index, preset in ipairs(presets) do
        assert(type(preset) == "table" and preset.Name ~= nil, "Cada preset precisa de Name")
        names[index] = tostring(preset.Name)
        byName[names[index]] = preset
    end

    local defaultName = tostring(config.Default or names[1])
    if not byName[defaultName] then defaultName = names[1] end
    local function apply(name)
        local preset = byName[name]
        if not preset then return end
        self.Window:SetTheme({ Accent = preset.Accent, Accent2 = preset.Accent2 })
        invoke(config.Callback, preset, name)
    end
    local control = self:AddDropdown({
        Name = config.Name or "Cor de destaque",
        Options = names,
        Default = defaultName,
        Mode = config.Mode or "Menu",
        Callback = apply,
    })
    apply(defaultName)
    return control
end

