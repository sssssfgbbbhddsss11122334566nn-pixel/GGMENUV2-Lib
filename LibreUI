    local suppressTextEvent = false
    local function setHexText(value)
        suppressTextEvent = true
        hexBox.Text = value
        suppressTextEvent = false
    end
    local dirty = false
    local function updateEditor()
        local field = fieldByKey[selectedKey]
        local color = currentColor(selectedKey)
        control.Key = selectedKey
        control.Value = color
        keyButton.Text = field.Label .. "   v"
        if not dirty then
            setHexText(colorToHex(color))
            swatch.BackgroundColor3 = color
            status.Text = "HEX #RRGGBB ou abreviado #RGB; aplique para confirmar."
            status.TextColor3 = window.Theme.Muted
        end
        for key, optionButton in pairs(optionButtons) do
            local selected = key == selectedKey
            optionButton.BackgroundColor3 = selected and window.Theme.Accent or window.Theme.Surface2
            optionButton.TextColor3 = selected and Color3.fromRGB(5, 18, 18) or window.Theme.Text
        end
    end
    function control:SetKey(key, silent)
        if not fieldByKey[key] then return false end
        selectedKey = key
        dirty = false
        updateEditor()
        menu.Visible = false
        if not silent then invoke(config.OnKeyChanged, selectedKey, currentColor(selectedKey)) end
        return true
    end
    function control:Apply(silent)
        local color = hexToColor(hexBox.Text)
        if not color then
            status.Text = "HEX inválido. Use #RRGGBB ou #RGB."
            status.TextColor3 = Color3.fromRGB(245, 105, 105)
            return false
        end
        dirty = false
        window:SetTheme({ [selectedKey] = color })
        swatch.BackgroundColor3 = color
        control.Value = color
        status.Text = fieldByKey[selectedKey].Label .. " aplicado: " .. colorToHex(color)
        status.TextColor3 = window.Theme.Accent
        if not silent then invoke(config.Callback, selectedKey, color, colorToHex(color)) end
        return true
    end
    function control:SetValue(value, silent)
        local color = typeof(value) == "Color3" and value or hexToColor(value)
        if not color then return false end
        dirty = false
        setHexText(colorToHex(color))
        swatch.BackgroundColor3 = color
        return control:Apply(silent)
    end
    function control:GetValue()
        return currentColor(selectedKey), selectedKey
    end
    function control:ResetColor(silent)
        dirty = false
        local color = window._initialTheme[selectedKey] or DEFAULTS[selectedKey]
        menu.Visible = false
        window:SetTheme({ [selectedKey] = color })
        updateEditor()
        if not silent then invoke(config.Callback, selectedKey, color, colorToHex(color)) end
    end
    function control:Reset(silent)
        selectedKey = initialKey
        control:ResetColor(silent)
    end

    local function updatePreviewFromText()
        if suppressTextEvent then return end
        dirty = true
        local color = hexToColor(hexBox.Text)
        if color then
            swatch.BackgroundColor3 = color
            status.Text = "Prévia: " .. colorToHex(color) .. " — clique em APLICAR."
            status.TextColor3 = window.Theme.Muted
            invoke(config.OnPreview, selectedKey, color)
        else
            status.Text = "HEX inválido. Use #RRGGBB ou #RGB."
            status.TextColor3 = Color3.fromRGB(245, 105, 105)
        end
    end

    for _, field in ipairs(fields) do
        window:_connect(optionButtons[field.Key].MouseButton1Click, function()
            control:SetKey(field.Key)
        end)
    end
    window:_connect(keyButton.MouseButton1Click, function() menu.Visible = not menu.Visible end)
    window:_connect(hexBox:GetPropertyChangedSignal("Text"), updatePreviewFromText)
    window:_connect(hexBox.FocusLost, function(enterPressed)
        updatePreviewFromText()
        if enterPressed and config.ApplyOnEnter then control:Apply() end
    end)
    window:_connect(applyButton.MouseButton1Click, function() control:Apply() end)
    window:_connect(resetButton.MouseButton1Click, function() control:ResetColor() end)

    updateEditor()
    window:_registerControl(control)
    window:_registerAccent(function()
        title.TextColor3 = window.Theme.Accent
        keyButton.BackgroundColor3 = window.Theme.Surface2
        keyButton.TextColor3 = window.Theme.Text
        hexBox.BackgroundColor3 = window.Theme.Surface2
        hexBox.TextColor3 = window.Theme.Text
