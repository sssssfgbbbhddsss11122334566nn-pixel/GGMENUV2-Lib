        resetButton.TextColor3 = window.Theme.Text
        menu.BackgroundColor3 = window.Theme.Surface2
        menu.ScrollBarImageColor3 = window.Theme.Accent
        updateEditor()
    end)
    return control
end

function Tab:AddKeybind(config)
    config = config or {}
    local theme = self.Window.Theme
    local initial = config.Default or Enum.KeyCode.RightShift
    if typeof(initial) ~= "EnumItem" or initial.EnumType ~= Enum.KeyCode then initial = Enum.KeyCode.RightShift end
    local row = self:_makeRow(42)

    local label = makeText(row, config.Name or "Atalho", 10, theme.Text, Enum.Font.GothamMedium)
    label.Position = UDim2.new(0, 11, 0, 0)
    label.Size = UDim2.new(1, -120, 1, 0)

    local keyButton = Instance.new("TextButton")
    keyButton.Size = UDim2.new(0, 92, 0, 26)
    keyButton.Position = UDim2.new(1, -102, 0.5, -13)
    keyButton.BackgroundColor3 = theme.Surface2
    keyButton.TextColor3 = theme.Text
    keyButton.TextSize = 9
    keyButton.Font = Enum.Font.GothamBold
    keyButton.Parent = row
    addCorner(keyButton, 6)

    local listening = false
    local window = self.Window
    local control = { Value = initial, Instance = row }
    local function render()
        keyButton.Text = listening and "PRESSIONE..." or control.Value.Name
    end
    function control:SetValue(value, silent)
        if typeof(value) ~= "EnumItem" or value.EnumType ~= Enum.KeyCode then return end
        control.Value = value
        listening = false
        window._listeningKeybind = false
        render()
        if config.BindWindow then window:SetShortcut(value) end
        if not silent then invoke(config.Callback, value) end
    end
    function control:GetValue()
        return control.Value
    end
    function control:Reset(silent)
        control:SetValue(initial, silent)
    end

    render()
    self.Window:_registerControl(control)
    self.Window:_registerAccent(function()
        keyButton.BackgroundColor3 = theme.Surface2
        keyButton.TextColor3 = theme.Text
        label.TextColor3 = theme.Text
    end)
    self.Window:_connect(keyButton.MouseButton1Click, function()
        listening = true
        window._listeningKeybind = true
        render()
    end)
    self.Window:_connect(UserInputService.InputBegan, function(input, processed)
        if listening and not processed and input.UserInputType == Enum.UserInputType.Keyboard then
            control:SetValue(input.KeyCode)
        end
    end)
    if config.BindWindow then window:SetShortcut(initial) end
    return control
end

