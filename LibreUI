    logo.Size = UDim2.fromOffset(4, 26)
    logo.Position = UDim2.new(0, 15, 0.5, -13)
    logo.BackgroundColor3 = theme.Accent
    logo.BorderSizePixel = 0
    logo.Parent = header
    addCorner(logo, 3)
    window._logoMark = logo
    window._header = header

    local title = makeText(header, options.Title or DEFAULTS.Title, 14, theme.Text, Enum.Font.GothamBlack)
