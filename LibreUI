        local function toggleMainMenu()
            mainMenu.Visible = not mainMenu.Visible
            modalMenu.Visible = false
            if renderSelector then renderSelector() end
        end
        local function toggleModalMenu()
            modalMenu.Visible = not modalMenu.Visible
            mainMenu.Visible = false
            if renderSelector then renderSelector() end
        end
        window:_connect(listButton.MouseButton1Click, toggleMainMenu)
        window:_connect(selectedLabel.MouseButton1Click, toggleMainMenu)
        window:_connect(modalListButton.MouseButton1Click, toggleModalMenu)
        window:_connect(modalSelectedLabel.MouseButton1Click, toggleModalMenu)

        local lastRenderedIndex
        local lastAccent
        local lastSurface
        local lastText
        renderSelector = function()
            local item = items[currentIndex]
            local name = tostring(item.Name or ("Item " .. currentIndex))
            local accent = window.Theme.Accent
            local surface = window.Theme.Surface2
            local textColor = window.Theme.Text
            listButton.Text = name .. "   v"
            modalListButton.Text = name .. "   v"
            selectedLabel.Text = "SELECIONADO: " .. name .. "  |  " .. currentIndex .. "/" .. #items
            modalSelectedLabel.Text = "SELECIONADO: " .. name .. "  |  " .. currentIndex .. "/" .. #items
            listButton.BackgroundColor3 = surface
            listButton.TextColor3 = textColor
            modalListButton.BackgroundColor3 = surface
            modalListButton.TextColor3 = textColor
            selectedLabel.TextColor3 = window.Theme.Muted
            modalSelectedLabel.BackgroundColor3 = surface
            modalSelectedLabel.TextColor3 = window.Theme.Muted
            mainMenu.BackgroundColor3 = surface
            modalMenu.BackgroundColor3 = surface
            mainMenu.ScrollBarImageColor3 = accent
            modalMenu.ScrollBarImageColor3 = accent

            local paletteChanged = surface ~= lastSurface or textColor ~= lastText
            if paletteChanged then
                for index, optionButton in ipairs(mainOptionButtons) do
                    local selected = index == currentIndex
                    optionButton.BackgroundColor3 = selected and accent or surface
                    optionButton.TextColor3 = selected and Color3.fromRGB(5, 18, 18) or textColor
                end
                for index, optionButton in ipairs(modalOptionButtons) do
                    local selected = index == currentIndex
                    optionButton.BackgroundColor3 = selected and accent or surface
                    optionButton.TextColor3 = selected and Color3.fromRGB(5, 18, 18) or textColor
                end
            elseif lastRenderedIndex ~= currentIndex then
                if lastRenderedIndex then
                    local oldMain = mainOptionButtons[lastRenderedIndex]
                    local oldModal = modalOptionButtons[lastRenderedIndex]
                    if oldMain then oldMain.BackgroundColor3 = surface; oldMain.TextColor3 = textColor end
                    if oldModal then oldModal.BackgroundColor3 = surface; oldModal.TextColor3 = textColor end
                end
                local newMain = mainOptionButtons[currentIndex]
                local newModal = modalOptionButtons[currentIndex]
                if newMain then newMain.BackgroundColor3 = accent; newMain.TextColor3 = Color3.fromRGB(5, 18, 18) end
                if newModal then newModal.BackgroundColor3 = accent; newModal.TextColor3 = Color3.fromRGB(5, 18, 18) end
            elseif accent ~= lastAccent then
                local selectedMain = mainOptionButtons[currentIndex]
                local selectedModal = modalOptionButtons[currentIndex]
                if selectedMain then selectedMain.BackgroundColor3 = accent end
                if selectedModal then selectedModal.BackgroundColor3 = accent end
            end
            lastRenderedIndex = currentIndex
            lastAccent = accent
            lastSurface = surface
            lastText = textColor
        end
    end

    local expandButton = Instance.new("TextButton")
